{
  "program_name": "BugBountyTarget",
  "base_url": "https://api.target.com",
  "in_scope_domains": [
    "api.target.com",
    "app.target.com",
    "graphql.target.com"
  ],
  "out_of_scope": [
    "blog.target.com",
    "help.target.com"
  ],
  "js_files": [
    "https://app.target.com/static/main.js",
    "https://app.target.com/static/app.bundle.js",
    "https://app.target.com/assets/vendor.js"
  ],
  "api_docs": [
    "https://api.target.com/swagger.json",
    "https://api.target.com/openapi.json",
    "https://graphql.target.com/graphql"
  ],
  "rate_limit": 10,
  "proxy": "http://127.0.0.1:8080",
  "custom_headers": {
    "X-Bug-Bounty": "AGI-idor"
  },
  "user_agent": "AGI-idor/1.0",
  "auth_mechanism": "bearer",
  "identifier_patterns": [
    "user_id", "account_id", "org_id", "order_id",
    "id", "uuid", "team_id", "project_id",
    "member_id", "invoice_id", "ticket_id"
  ]
}
